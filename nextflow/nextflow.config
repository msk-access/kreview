// Single source of truth for the released version. `manifest` is NOT resolvable from
// `process`/`profiles` scope on Nextflow 24+, so container tags read this param instead
// and the manifest reads it back — one literal, five consumers.
// Kept in sync with settings.ini and kreview/__init__.py by scripts/check_version_consistency.py.
params.kreview_version = '0.0.32'

manifest {
    name            = 'kreview'
    author          = 'MSK-ACCESS Team'
    homePage        = 'https://github.com/msk-access/kreview'
    description     = 'Evaluation Dashboard for Krewlyzer Fragmentomics Parameters'
    mainScript      = 'main.nf'
    // Supported range: v25-v26 (both tested). The floor is 25.04.0 because the config
    // uses env(), added in 24.11. `!` makes an unsupported version a hard error rather
    // than a warning followed by a cryptic parse failure further down the file.
    nextflowVersion = '!>=25.04.0'
    version         = params.kreview_version
}

params {
    // Required Inputs
    cancer_samplesheet      = null
    healthy_xs1_samplesheet = null
    healthy_xs2_samplesheet = null
    cbioportal_dir          = null
    krewlyzer_dir           = null
    
    // Output options
    outdir                  = './results'

    // Workflow Selection
    // 'eval'  — Full pipeline: Label → Extract → Select → Eval → Report (default)
    // 'label' — Label only: generate labels.parquet without feature extraction
    workflow                = 'eval'

    // ML Engine Tunables
    cv_folds                = 5
    top_percentile          = 10.0
    strategy                = 'mrmr'
    impute_strategy         = 'median'
    chunk_size              = 'auto'    // Dynamic: probes parquet row density at runtime
        
    // Execution Control
    resume_eval             = false     // Skip evaluators with existing model results
    skip_report             = false     // Skip the single-page report render
    compute_univariate_auc  = false     // Per-feature univariate LR AUC (~10s per evaluator)
    export_duckdb           = false     // Export consolidated DuckDB lake (high memory cost)
    ch_hotspot_maf          = null      // Optional CH hotspot MAF for CH-only demotion

    // Reproducibility
    seed                    = 42        // Random seed for all models and CV splits
    deterministic           = true      // PyTorch deterministic mode (slower, bit-exact GPU repro)

    // Labeling Engine Tunables
    min_vaf                 = 0.01      // Min VAF for Possible ctDNA+ classification
    min_fragments           = 2000      // Min fragments PF — below → Insufficient Data
    min_variants            = 1         // Min # variants passing VAF for Possible ctDNA+

    // Targeted Execution Filters
    features                = null      // E.g. "AtacOnTarget,FSCOnTarget"
    tier                    = null      // E.g. 1 or 2

    // Multi-stage Pipeline Options
    run_gpu_eval            = false     // Enable KREVIEW_EVAL_GPU step
    gpu_models              = 'tabpfn,tabicl' // GPU foundation models (tabpfn, tabpfn_ft, tabicl, tabicl_ft)
    gpu_device              = 'cuda'          // PyTorch device
    gpu_finetune_epochs     = 50              // Fine-tuning epochs for _ft variants
    gpu_finetune_lr         = 1e-5            // Fine-tuning learning rate for _ft variants
    tabpfn_token            = null            // TabPFN API key (https://ux.priorlabs.ai/account)
    run_multimodal_eval     = false     // Enable decomposed multimodal pipeline
    run_ablation            = false     // Enable nested CV feature ablation before eval
    ablation_inner_folds    = 3        // Inner CV folds for ablation subset selection
    multimodal_models       = 'rf,xgb'        // Models for multimodal eval
    multimodal_top_percentile = 10.0           // Top N% feature selection (replaces top_k)
    multimodal_selection    = 'grootcv'       // default since #96 (most stable, measured); also 'mi', 'leshy', deprecated 'boruta_shap'
    multimodal_selection_cutoff = 3.0         // GrootCV shadow-importance divisor (#96 sweep)
    multimodal_selection_n_iter = 10          // GrootCV shadow-test iterations (#96 agreement check)
    multimodal_gpu_models   = ''              // GPU models for multimodal: 'tabpfn_ft,tabicl_ft'
    multimodal_cpu_only     = false           // Legacy: decomposed pipeline routes CPU/GPU per-process
    skip_gpu_joblib         = false           // Skip saving GPU model joblib files (>200MB each)
    max_gpu_features        = 150             // GPU feature cap — top N by MI/AUC (0 = disable)
    min_evaluators          = 1         // Min evaluators per sample for fuse filtering

    // DuckDB Resource Tuning (passed through to kreview extract CLI)
    duckdb_threads          = 8       // DuckDB query threads (match KREVIEW_EXTRACT cpus)
    duckdb_memory           = '32GB'  // DuckDB memory limit for parquet aggregation

    help = false

    // SLURM partition override (comma-separated for multi-partition scheduling)
    partition       = null
    gpu_partition   = null              // GPU partition for KREVIEW_EVAL_GPU

    // nf-core institutional config support
    custom_config_version = 'master'
    custom_config_base    = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
}

// ── Centralized HPC env setup (#58) ────────────────────────────────────────────
// One definition each for the GPU and report/Quarto processes, interpolated into every
// module's `script:` block so the read-only-/home, cache-redirect, CUDA-fragmentation and
// matplotlib-config hardening is applied once and identically — not copy-pasted (and drifting)
// per module. These are single-quoted, so `${PWD}` / `$HOME` stay literal and bash expands
// them at run time in the task work dir.
//
// Deliberately kept IN the script (not a `beforeScript`): the nf-core iris institutional
// config sets its OWN `beforeScript` (SINGULARITYENV scratch setup), and `beforeScript` is a
// single non-additive directive — a kreview `beforeScript` would clobber it or be clobbered.
// See .agents/memory/reference-iris-config-interaction.md.
params.gpu_env_setup = '''export HOME=${PWD}/.home && mkdir -p $HOME
export TMPDIR=${PWD}/tmp && mkdir -p $TMPDIR
export XDG_CACHE_HOME=${PWD}/.cache && mkdir -p $XDG_CACHE_HOME
export IPYTHONDIR=${PWD}/.ipython && mkdir -p $IPYTHONDIR
export HF_HOME=${XDG_CACHE_HOME}/huggingface
export TABPFN_DATA_DIR=${XDG_CACHE_HOME}/tabpfn
export TABPFN_MODEL_CACHE_DIR=${XDG_CACHE_HOME}/tabpfn
export TABPFN_NO_BROWSER=true
export NUMBA_CACHE_DIR=${PWD}/.numba_cache && mkdir -p $NUMBA_CACHE_DIR
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True'''

params.report_env_setup = '''export HOME=${PWD}/.home && mkdir -p $HOME
export TMPDIR=${PWD}/tmp && mkdir -p $TMPDIR
export XDG_CACHE_HOME=${PWD}/.quarto_cache && mkdir -p $XDG_CACHE_HOME
export XDG_DATA_HOME=${PWD}/.quarto_data && mkdir -p $XDG_DATA_HOME
export IPYTHONDIR=${PWD}/.ipython && mkdir -p $IPYTHONDIR
export MPLCONFIGDIR=${PWD}/.mplconfig && mkdir -p $MPLCONFIGDIR'''

// NOTE (#58): the per-`withName` resource ladders below are NOT duplication to eliminate.
// iris's institutional config overrides `withLabel` (later load wins) and its dynamic queue can
// inject a `cpu` partition the account lacks, so each ladder is pinned at `withName` (which
// always beats `withLabel`) as defensive armour. They cannot be hoisted into a shared `def`
// closure either — Nextflow 24+ rejects `def` at config top level ("Variable declarations
// cannot be mixed with config statements"). See reference-iris-config-interaction.md.

process {
    cache  = 'lenient'  // GPFS/Spectrum Scale breaks default inode-based hashing; use name+size only
    cpus   = 4
    memory = '16 GB'
    time   = '1h'
    shell  = ['/bin/bash', '-euo', 'pipefail']
    container = "ghcr.io/msk-access/kreview:v${params.kreview_version}"
    queue  = params.partition   // null by default; set by SLURM/iris profiles
    clusterOptions = ''

    // Retry strategy: cap walltime at 2.5h so retries stay within cmobic_short (3h limit)
    // NOTE: The nf-core iris institutional config overrides these defaults with:
    //   errorStrategy = { task.attempt < 4 ? 'retry' : 'ignore' }
    //   queue = { ... dynamic closure including 'cpu' partition ... }
    // Pin critical settings in withName blocks to prevent silent failures.
    errorStrategy = 'retry'
    maxRetries    = 2

    // ── Resource labels ──
    withLabel: 'process_low' {
        cpus   = 2
        memory = 8.GB
        time   = 30.min
        queue  = params.partition ?: 'cmobic_short'
    }

    withLabel: 'process_medium' {
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { [2.h * task.attempt, 2.5.h].min() }
        queue  = params.partition ?: 'cmobic_short'
    }

    withLabel: 'process_high' {
        cpus   = 8
        memory = { 64.GB * task.attempt }
        time   = { [2.h * task.attempt, 2.5.h].min() }
        queue  = params.partition ?: 'cmobic_short'
    }

    withLabel: 'process_gpu' {
        cpus   = 4
        memory = { 64.GB * task.attempt }
        time   = { task.attempt <= 1 ? 2.h : 6.h }  // gpushort (2h) first, then gpu (6h) on retry
        // GPU container: includes torch, tabpfn, tabicl (CUDA 12.4)
        container      = "ghcr.io/msk-access/kreview:v${params.kreview_version}-gpu"
        queue          = { task.attempt <= 1 ? (params.gpu_partition ?: 'gpushort') : 'gpu' }
        clusterOptions = '--gres=gpu:1'
    }

    // ── Per-process withName overrides ──
    // withName takes precedence over institutional configs' withLabel
    // overrides, ensuring kreview always gets the right resources.
    //
    // IMPORTANT: The nf-core iris institutional config sets a dynamic queue
    // closure that injects "cpushort,cpu,..." for short tasks. If your account
    // lacks access to the 'cpu' partition, SLURM rejects the entire sbatch.
    // Pin `queue` explicitly on critical processes to bypass this.
    // Also pin `errorStrategy` on mandatory processes (LABEL) to prevent the
    // iris config from silently ignoring failures via 'ignore' strategy.

    // Monolithic mode (backward compat)

    // Multistage: labeling is lightweight (~30s, low memory)
    // Label is MANDATORY — pipeline cannot continue without labels.parquet
    withName: 'KREVIEW_LABEL' {
        cpus          = 2
        memory        = { 8.GB * task.attempt }
        time          = { 30.min * task.attempt }
        queue         = params.partition ?: 'cmobic_short'  // Pin partition; bypass iris dynamic queue
        errorStrategy = 'terminate'  // NEVER ignore — pipeline must abort if labeling fails
        cache         = 'lenient'    // Pin at withName — immune to iris cache=true override
        scratch       = false        // Label writes <1MB, no /localscratch needed
    }

    // Multistage: per-evaluator extraction streams one chunk at a time
    // Memory profile: ~6 GB for most evaluators. WPSGenome uses SQL pushdown
    // (list_avg/list_max/list_min) reducing peak from 96+ GB to ~17 GB.
    // 3 retries → memory ladder: 64→128→192 GB covers all evaluators.
    // Time escalation: retries 1-2 stay on cmobic_short (fast queue, 2.5h cap).
    //   retries 3+ escalate to cmobic_cpu (24h partition) with 8h limit.
    withName: 'KREVIEW_EXTRACT' {
        cpus          = 8
        memory        = { 64.GB * task.attempt }
        time          = { task.attempt <= 2 ? [1.5.h * task.attempt, 3.h].min() : 8.h }
        queue         = { task.attempt <= 2 ? (params.partition ?: 'cmobic_short') : 'cmobic_cpu' }
        maxRetries    = 3
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
    }

    // Multistage: fuse is fast (in-memory pandas join)
    // FUSE is mandatory — EVAL/REPORT cannot function without the super-matrix.
    // Use 'terminate' (not 'ignore') so the pipeline stops cleanly on failure.
    withName: 'KREVIEW_FUSE' {
        cpus          = 2
        memory        = { 16.GB * task.attempt }
        time          = { [30.min * task.attempt, 2.5.h].min() }
        queue         = params.partition ?: 'cmobic_short'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'terminate' }
        maxRetries    = 3
    }

    // Multistage: scoreboard aggregation (needs all JSONs)
    // Lightweight Python job — build_scoreboard() reads JSON files only.
    // Pin errorStrategy: if scoreboard fails, report still renders via
    // .ifEmpty(file('NO_SCOREBOARD')) guard in kreview_eval.nf.
    withName: 'KREVIEW_SCOREBOARD' {
        cpus          = 2
        memory        = { 16.GB * task.attempt }
        time          = { 30.min * task.attempt }
        queue         = params.partition ?: 'cmobic_short'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries    = 3
    }

    // NOTE: the `KREVIEW_EVAL_CPU` / `KREVIEW_EVAL_GPU` selectors that used to sit here were
    // removed in #80. They targeted the Gen-1 "bulk" modules deleted in #55, so Nextflow
    // emitted `WARN: There's no process matching config selector` on every run. The
    // per-evaluator `*_SINGLE` selectors above are the live equivalents.

    // Decomposed multimodal pipeline — prep (CPU)
    withName: 'KREVIEW_MULTIMODAL_PREP' {
        cpus          = 4
        memory        = { 32.GB * task.attempt }
        time          = { [30.min * task.attempt, 1.h].min() }
        queue         = params.partition ?: 'cmobic_short'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries    = 3
    }

    // Decomposed multimodal pipeline — single model GPU (tabpfn_ft, tabicl_ft)
    withName: 'KREVIEW_MULTIMODAL_SINGLE_GPU' {
        cpus          = 4
        memory        = { 64.GB * task.attempt }
        time          = { task.attempt <= 1 ? 2.h : 6.h }
        queue         = { task.attempt <= 1 ? (params.gpu_partition ?: 'gpushort') : 'gpu' }
        // GPU script always exits 0 (emits error JSON on failure).
        // Pin errorStrategy to prevent iris config from injecting 'ignore',
        // which causes collect() deadlock (ignored outputs never reach channels).
        errorStrategy = 'retry'
        maxRetries    = 3
        cache         = 'lenient'     // Pin at withName — immune to iris cache=true override (GPFS breaks inode hashing)
        container     = "ghcr.io/msk-access/kreview:v${params.kreview_version}-gpu"
        clusterOptions = '--gres=gpu:1'
        scratch       = false
    }

    // Decomposed multimodal pipeline — single model CPU (rf, xgb)
    withName: 'KREVIEW_MULTIMODAL_SINGLE_CPU' {
        cpus          = 4
        memory        = { 32.GB * task.attempt }
        time          = { [1.h * task.attempt, 2.5.h].min() }
        queue         = params.partition ?: 'cmobic_short'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries    = 3
    }

    // Decomposed multimodal pipeline — ablation (CPU, uses best stacking model)
    // #97: LOO ablation retrains the BEST stacking model. A GPU model (tabpfn/tabicl) can
    // only be the best when params.multimodal_gpu_models is set — that is known at config
    // time, so route this stage to the GPU container + partition exactly then (mirroring
    // KREVIEW_MULTIMODAL_SINGLE_GPU), and keep it on CPU otherwise. On the iris v0.0.29 run
    // the CPU-scheduled stage could not build the winning tabicl and the whole multimodal
    // tail was lost. The Python-level loud fallback remains as defence-in-depth for
    // environments where even the routed container lacks the winning model.
    withName: 'KREVIEW_MULTIMODAL_ABLATION' {
        cpus          = 4
        // Ternaries are INSIDE the closures: Nextflow 26's config analyzer rejects `task`
        // references in a closure nested inside a ternary (`p ? {task…} : {task…}`).
        memory        = { params.multimodal_gpu_models ? 64.GB * task.attempt : 32.GB * task.attempt }
        // GPU: gpushort (2h) first, escalate to gpu (6h) — LOO over all evaluators with an
        // in-context model is the heaviest multimodal step. CPU: original short ladder.
        time          = { params.multimodal_gpu_models ? (task.attempt <= 1 ? 2.h : 6.h) : [30.min * task.attempt, 1.h].min() }
        queue         = { params.multimodal_gpu_models ? (task.attempt <= 1 ? (params.gpu_partition ?: 'gpushort') : 'gpu') : (params.partition ?: 'cmobic_short') }
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries    = 3
        cache         = 'lenient'     // Pin at withName — immune to iris cache=true override
        // MUST pin container at withName (overrides withLabel) — GPU image ships tabpfn/tabicl.
        container     = params.multimodal_gpu_models ? "ghcr.io/msk-access/kreview:v${params.kreview_version}-gpu" : "ghcr.io/msk-access/kreview:v${params.kreview_version}"
        clusterOptions = params.multimodal_gpu_models ? '--gres=gpu:1' : ''
    }

    // Decomposed multimodal pipeline — merge partial JSONs into final result
    withName: 'KREVIEW_MULTIMODAL_MERGE' {
        cpus          = 2
        memory        = 8.GB
        time          = 30.min
        queue         = params.partition ?: 'cmobic_short'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries    = 3
    }

    // #79: the report is now a lightweight aggregation + template injection — no Quarto,
    // no render-time SHAP — so the old 64→192 GB ladder is gone. 8 GB covers the OOF-array
    // loads with headroom. (The separate REPORT_MULTIMODAL process was folded in here.)
    withName: 'KREVIEW_REPORT' {
        cpus          = 2
        memory        = { 8.GB * task.attempt }
        time          = { [20.min * task.attempt, 1.h].min() }
        queue         = params.partition ?: 'cmobic_short'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries    = 3
        scratch       = false  // Preserve HTML outputs — iris sets /localscratch by default
    }

    // ── Per-evaluator scatter modules (lighter than bulk) ──
    // These run ×N in parallel; each handles a single evaluator matrix.

    // One bad evaluator should not terminate the pipeline — use ignore.
    withName: 'KREVIEW_SELECT_SINGLE' {
        cpus          = 4
        memory        = { 16.GB * task.attempt }
        time          = { [30.min * task.attempt, 2.5.h].min() }
        queue         = params.partition ?: 'cmobic_short'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries    = 3
    }

    withName: 'KREVIEW_EVAL_CPU_SINGLE' {
        cpus          = 4
        memory        = { 32.GB * task.attempt }
        time          = { [1.h * task.attempt, 2.5.h].min() }
        queue         = params.partition ?: 'cmobic_short'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries    = 3
        scratch       = false  // Preserve .joblib outputs — iris sets /localscratch by default
    }

    withName: 'KREVIEW_EVAL_GPU_SINGLE' {
        cpus   = 4
        memory = { 64.GB * task.attempt }
        // gpushort max = 2h; on retry escalate to gpu partition (longer walltime)
        time   = { task.attempt <= 1 ? 2.h : 6.h }
        queue  = { task.attempt <= 1 ? (params.gpu_partition ?: 'gpushort') : 'gpu' }
        cache  = 'lenient'     // Pin at withName — immune to iris cache override
        // GPU script always exits 0 (emits error JSON on failure).
        // Pin errorStrategy to prevent iris config from injecting 'ignore',
        // which causes collect() deadlock (ignored outputs never reach channels).
        errorStrategy  = 'retry'
        maxRetries     = 3
        // MUST pin container here — withName blocks override withLabel:process_gpu
        container      = "ghcr.io/msk-access/kreview:v${params.kreview_version}-gpu"
        clusterOptions = '--gres=gpu:1'
        scratch        = false  // Preserve .joblib outputs — iris sets /localscratch by default
    }

    // ── Ablation processes (v0.0.20) ──
    withName: 'KREVIEW_ABLATE_CPU_SINGLE' {
        cpus          = 4
        memory        = { 64.GB * task.attempt }
        time          = { [1.h * task.attempt, 2.5.h].min() }
        queue         = params.partition ?: 'cmobic_short'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries    = 3
    }

    withName: 'KREVIEW_ABLATE_GPU_SINGLE' {
        cpus   = 4
        memory = { 64.GB * task.attempt }
        time   = { task.attempt <= 1 ? 2.h : 6.h }
        queue  = { task.attempt <= 1 ? (params.gpu_partition ?: 'gpushort') : 'gpu' }
        errorStrategy  = 'retry'
        maxRetries     = 3
        container      = "ghcr.io/msk-access/kreview:v${params.kreview_version}-gpu"
        clusterOptions = '--gres=gpu:1'
    }

    withName: 'KREVIEW_MERGE_ABLATION' {
        cpus          = 2
        memory        = 8.GB
        time          = 30.min
        queue         = params.partition ?: 'cmobic_short'
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries    = 3
    }
}

// Load nf-core institutional configs (e.g. iris, jax, sanger, etc.)
// See: https://github.com/nf-core/configs
// Load nf-core institutional configs (iris, jax, sanger, ...).
// Nextflow 24+ forbids try/catch AND if-statements around `includeConfig`, so this uses
// the nf-core ternary idiom: a falsy condition includes /dev/null instead. Honours
// NXF_OFFLINE so an air-gapped run does not attempt the network fetch.
includeConfig !env('NXF_OFFLINE') && params.custom_config_base ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

profiles {
    // Smoke-test profile: pair with `-stub-run` to exercise DAG wiring without real compute.
    // Every process declares a `stub:` block that only touches its declared outputs, so the
    // production resource ladders (up to 64 GB / 8 CPU) would otherwise make the run
    // unschedulable on a laptop or a CI runner. This clamps them to something trivially
    // satisfiable and disables retries so a wiring bug fails fast instead of retrying 3×.
    // Not for real runs — it under-provisions every process on purpose.
    stub {
        process {
            // `withName: '.*'` (not a bare `process` block) because a named selector outranks
            // the generic scope — without it the production `withName: 'KREVIEW_EXTRACT'`
            // ladder still asks for 64 GB and the run is unschedulable.
            withName: '.*' {
                executor      = 'local'
                cpus          = 1
                memory        = 1.GB
                time          = 10.min
                errorStrategy = 'terminate'
                maxRetries    = 0
            }
        }
        docker.enabled      = false
        singularity.enabled = false
    }

    docker {
        docker.enabled      = true
        docker.runOptions   = '-v /:/ -v /Users:/Users' // Grant absolute access for URI binding
        singularity.enabled = false
    }

    slurm {
        process {
            executor       = 'slurm'
        }
        singularity {
            enabled    = true
            autoMounts = true  // Crucial for scanning 14K parquet directories
        }
        docker.enabled = false
        
        // HPC Optimization — GPFS has no SFTP file descriptor limits
        params.chunk_size    = 'auto'  // Dynamic: probes row density (GPFS has no FD limits)
        params.cv_folds      = 10
        params.resume_eval   = true
    }

    // IRIS HPC profile — works WITH nf-core iris institutional config
    // Routes to cmobic_short (3h limit) — more nodes, faster scheduling
    iris {
        // Override iris institutional config defaults
        params.partition     = 'cmobic_short'
        params.gpu_partition = 'gpushort'   // IRIS GPU partition (max 2h)

        process {
            executor       = 'slurm'
            cache          = 'lenient'   // iris config sets true; we need lenient for GPFS
        }
        singularity {
            enabled    = true
            autoMounts = true
            // `${HOME}` is not resolvable in config on Nextflow 24+; env() is the supported reader.
            cacheDir   = env('SINGULARITY_CACHEDIR') ?: "${env('HOME')}/.singularity_cache"
            // -B /data1: bind mount for cbioportal + krewlyzer val paths
            // --nv: expose host NVIDIA GPU drivers to container (required for GPU eval)
            runOptions = '-B /data1 --nv'
        }
        docker.enabled = false

        // HPC Optimization — GPFS has no SFTP file descriptor limits
        params.chunk_size    = 'auto'  // Dynamic: probes row density (GPFS has no FD limits)
        params.cv_folds      = 10
        params.resume_eval   = true
    }
}

// Execution reporting logs
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}
